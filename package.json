{
  "name": "aoe4-counter-pick",
  "version": "0.5.0",
  "description": "Browser extension (Firefox, Chrome, Edge, Brave…) that shows AoE4 counter picks and draft win-rate estimates on aoe2cm.net drafts.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build.mjs firefox",
    "build:chrome": "node scripts/build.mjs chrome",
    "test": "node --test",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "web-ext": "^8.3.0"
  }
}

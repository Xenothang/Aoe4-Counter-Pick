{
  "manifest_version": 3,
  "name": "AoE4 Counter Pick for AoE2CM",
  "description": "Shows the strongest AoE4 ranked-solo counters to the opponent's picks on aoe2cm.net drafts, with win-rate estimates.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://aoe4world.com/*",
    "https://www.aoe4world.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://aoe2cm.net/*", "https://www.aoe2cm.net/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
